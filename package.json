{
  "name": "@npm/react-form-bit",
  "version": "0.1.0",
  "description": "A flexible React form generator with Tailwind CSS v4",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index/js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode lib",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.7",
    "@types/node": "^24.10.1",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^4.0.7",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.9.1",
    "vite-plugin-eslint": "^1.8.1"
  },
  "keywords": [
    "react",
    "form",
    "form-generator",
    "tailwind",
    "tailwindcss",
    "typescript",
    "components"
  ],
  "author": "Amir Hossein Jamshidi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/amir-jamshidi/react-form-bit.git"
  },
  "bugs": {
    "url": "https://github.com/amir-jamshidi/react-form-bit/issues"
  },
  "homepage": "https://github.com/amir-jamshidi/react-form-bit#readme"
}
